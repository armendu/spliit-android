<?xml version="1.0" encoding="utf-8"?>
<!-- Spliit has no accounts: the group list is the only way back to a group, so it travels with a backup. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
